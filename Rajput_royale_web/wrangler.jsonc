// Cloudflare Workers config: serves the Vite build in dist/ as a static site.
// The Git-connected build runs `npm run build`, then `npx wrangler deploy`.
{
  "name": "rajput-royale",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true,
  "preview_urls": true
}
